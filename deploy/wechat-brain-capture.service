[Unit]
Description=WeChat Brain Capture daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/kos/projects/side_projects/kos
EnvironmentFile=/home/kos/projects/side_projects/kos/.env
ExecStart=/usr/bin/node /home/kos/projects/side_projects/kos/dist/src/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
