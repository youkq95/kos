# Absolute path to the Markdown brain log file.
BRAIN_LOG_PATH=/home/your-user/brain/log.md

# Comma-separated whitelisted Weixin user IDs (e.g. xxx@im.wechat).
ALLOWED_SENDERS=xxx@im.wechat

TIMEZONE=Asia/Shanghai

# State file for persisting bot credentials and poll cursor.
STATE_PATH=/var/lib/wechat-brain-capture/state.json

LOG_LEVEL=info

# ── Weixin iLink Bot API ──────────────────────────────────────────
# Base URL for the iLink gateway (https://ilinkai.weixin.qq.com).
WEIXIN_BASE_URL=https://ilinkai.weixin.qq.com

# These can be left empty — the daemon will obtain them via QR login
# and persist them to STATE_PATH.  Pre-fill them to skip the login flow.
WEIXIN_BOT_TOKEN=
WEIXIN_BOT_ID=
WEIXIN_USER_ID=
WEIXIN_ROUTE_TAG=

WEIXIN_REQUEST_TIMEOUT_MS=65000

# ── QR login ──────────────────────────────────────────────────────
LOGIN_POLL_INTERVAL_MS=2000
QR_OUTPUT_PATH=/tmp/kos-qr.png

# ── Poller ────────────────────────────────────────────────────────
POLLER_MIN_BACKOFF_MS=1000
POLLER_MAX_BACKOFF_MS=30000
